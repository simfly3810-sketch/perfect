rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 아래 목록에 있는 이메일로 로그인한 사람만 읽고 쓸 수 있어요.
    function allowed() {
      return request.auth != null
        && request.auth.token.email in [
          'lyr3810@naver.com',
          'lyr3810@mcircle.biz'
        ];
    }
    match /{document=**} {
      allow read, write: if allowed();
    }
  }
}
